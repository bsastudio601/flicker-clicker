[sub_resource type="GDScript" id="GDScript_f6a44"]
script/source = "extends Control

@onready var setting_popup:Panel = $SettingWindow
@onready var setting_button: TextureButton =  $Setting_button


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	setting_popup.hide()
	
	pass # Replace with function body.



func _on_texture_button_pressed() -> void:
	if setting_popup.visible:
		setting_popup.hide()
		$SettingWindow/button_click_sfx.play()
	else:
		setting_popup.show()
		$SettingWindow/button_click_sfx.play()


func _on_save_pressed() -> void:
	SaveLoad._save()
	pass # Replace with function body.


func _on_load_pressed() -> void:
	SaveLoad._load()
	pass # Replace with function body.
"

