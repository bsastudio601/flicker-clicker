[node name="Consumption1" parent="UI/News_Popup/Panel/Item_List/Item_Vbox" unique_id=2082741052 instance=ExtResource("18_xrs0c")]
layout_mode = 2
headline = "Corner Store Adds Cold Storage"
date = "01-01-2025"
details = "A corner grocery on Pine Street has installed two more refrigerated cabinets to stock fresh produce and dairy. The owner says customers had been asking for months. Each cabinet runs around the clock on the local grid, and while the individual load is small, the first extra cooling units always are."
consumption_adds = 5.0
gps_required = 30.0
applied_delay = 20.0

[node name="Hint1" parent="UI/News_Popup/Panel/Item_List/Item_Vbox" unique_id=1423266293 instance=ExtResource("18_xrs0c")]
layout_mode = 2
headline = "Utility Reports Steady Growth In Evening Load"
date = "05-01-2025"
details = "The regional utility reports that evening electricity use has grown for six months in a row, as shops stay open later and more homes switch to electric appliances. Analysts say the trend is likely to continue, and the coming weeks may bring more businesses extending their opening hours."
gps_required = 78.0
applied_delay = 35.0

[node name="Consumption2" parent="UI/News_Popup/Panel/Item_List/Item_Vbox" unique_id=1590839420 instance=ExtResource("18_xrs0c")]
layout_mode = 2
headline = "Evening Demand Rises As Shops Extend Hours"
date = "10-01-2025"
details = "Several shops along the main road now stay open until ten at night, and the lights, tills and signs stay on with them. Shopkeepers report better sales after dark, and the grid operator reports higher evening use. Longer opening hours are good for business, but they keep demand elevated for more of each day.


"
consumption_adds = 5.0
gps_required = 85.0
applied_delay = 20.0

[node name="Hint2" parent="UI/News_Popup/Panel/Item_List/Item_Vbox" unique_id=1806874102 instance=ExtResource("18_xrs0c")]
layout_mode = 2
headline = "Developer Files Plans For New Apartment Block"
date = "11-01-2025"
details = "A developer has filed plans with the council for a six-storey apartment block on the old timber yard. The building would add dozens of homes, with lifts, heating and shared lighting. If approved, the block would connect to the local feeder line, which already carries a busy load after sunset."
gps_required = 90.0
applied_delay = 54.0

[node name="Consumption3" parent="UI/News_Popup/Panel/Item_List/Item_Vbox" unique_id=1284790625 instance=ExtResource("18_xrs0c")]
layout_mode = 2
headline = "New Apartment Block Connects To The Feeder"
date = "02-03-2025"
details = "The new apartment block on the old timber yard has finished construction, and the first residents are moving in. Lifts, corridor lighting and electric heating are now connected to the local feeder line. The utility says the extra load was expected, but it adds to a grid that already runs close to its comfortable limits."
consumption_adds = 20.0
gps_required = 98.0
applied_delay = 48.0

[node name="Hint3" parent="UI/News_Popup/Panel/Item_List/Item_Vbox" unique_id=1527883424 instance=ExtResource("18_xrs0c")]
layout_mode = 2
headline = "City Approves Charging Stations On Main Street"
date = "05-03-2025"
details = "The city council has voted to install six electric vehicle charging stations on Main Street, with work starting next month. Supporters say drivers will stop and shop while their cars charge. The utility notes that fast chargers draw a great deal of power when several cars plug in at the same time."
gps_required = 158.0
applied_delay = 60.0

[node name="Consumption4" parent="UI/News_Popup/Panel/Item_List/Item_Vbox" unique_id=262201083 instance=ExtResource("18_xrs0c")]
layout_mode = 2
headline = "Electric Vehicle Hub Opens Downtown"
date = "01-04-2025"
details = "The new charging hub on Main Street opened this week, and every bay was busy by lunchtime. Drivers like the speed, but fast chargers pull heavy current in short bursts. Grid engineers say the hub has already become one of the largest single loads in the neighbourhood, and use is expected to keep growing."
consumption_adds = 45.0
gps_required = 220.0
applied_delay = 30.0

[node name="Hint4" parent="UI/News_Popup/Panel/Item_List/Item_Vbox" unique_id=961442891 instance=ExtResource("18_xrs0c")]
layout_mode = 2
headline = "Grid Operator Forecasts Record Evening Peak"
date = "16-04-2025"
details = "The grid operator has published its seasonal outlook and expects a new record for evening peak demand within weeks. Cooking, lighting, charging and heating all overlap after six o'clock. Operators say they will watch the weekly figures closely, and warn that one busy week could push the system past its previous high."
gps_required = 230.0
applied_delay = 38.0

[node name="Consumption5" parent="UI/News_Popup/Panel/Item_List/Item_Vbox" unique_id=1163316954 instance=ExtResource("18_xrs0c")]
layout_mode = 2
headline = "Evening Demand Sets A New Record"
date = "10-05-2025"
details = "The grid operator confirmed a new record for evening peak demand on Tuesday, higher than any day this year. Cooking, charging, heating and lighting all overlapped at the same hour. Households noticed little, but operators had to hold extra reserve capacity, which means more power must now be produced simply to stay safe.
"
consumption_adds = 55.0
gps_required = 240.0
applied_delay = 60.0

[node name="Consumption6" parent="UI/News_Popup/Panel/Item_List/Item_Vbox" unique_id=1845335343 instance=ExtResource("18_xrs0c")]
layout_mode = 2
headline = "Hospital Annex Opens Its Doors"
date = "14-05-2025"
details = "The hospital's new outpatient annex opened on Monday, bringing imaging machines, ventilation and round-the-clock lighting online. Medical equipment cannot afford interruptions, so the annex gets priority access to power. The health authority says patients will benefit, and the utility says the extra continuous load is now a permanent part of the grid."
consumption_adds = 60.0
gps_required = 260.0
applied_delay = 16.0

[node name="Hint5" parent="UI/News_Popup/Panel/Item_List/Item_Vbox" unique_id=1598494102 instance=ExtResource("18_xrs0c")]
layout_mode = 2
headline = "Weather Service Issues Heat Advisory"
date = "27-06-2025"
details = "The weather service has issued a heat advisory for the coming week, with temperatures expected to stay above thirty degrees. Officials urge residents to check on elderly neighbours and drink plenty of water. Utility planners note that days like these keep air conditioners running all afternoon, and demand tends to climb quickly."
gps_required = 280.0
applied_delay = 60.0

[node name="Consumption7" parent="UI/News_Popup/Panel/Item_List/Item_Vbox" unique_id=1357892717 instance=ExtResource("18_xrs0c")]
layout_mode = 2
headline = "Heat Wave Pushes Cooling Demand To A High"
date = "01-07-2025"
details = "The heat wave arrived as forecast, and air conditioners across the district have been running from noon until midnight. Offices, shops and homes all want cooler air at the same time. The utility says afternoon demand has reached its highest level of the year, and power lines lose more energy in the heat as well."
consumption_adds = 100.0
gps_required = 337.0
applied_delay = 60.0

[node name="Consumption8" parent="UI/News_Popup/Panel/Item_List/Item_Vbox" unique_id=1984660749 instance=ExtResource("18_xrs0c")]
layout_mode = 2
headline = "Rising Line Losses Reported On Old Cables"
date = "10-08-2025"
details = "A technical audit found that older distribution cables near the river lose more power than expected, especially under heavy load. Utility crews plan to replace the worst sections next year. Until then, a small share of every unit sent along those lines is lost as heat before it ever reaches a customer."
consumption_adds = 100.0
gps_required = 460.0
applied_delay = 30.0

[node name="Consumption9" parent="UI/News_Popup/Panel/Item_List/Item_Vbox" unique_id=806103811 instance=ExtResource("18_xrs0c")]
layout_mode = 2
headline = "Water Plant Expansion Comes Online"
date = "12-08-2025"
details = "The city water plant finished its expansion this month, adding two large pumps and a new filtration hall. The upgrade improves supply for the growing district, but pumps are among the largest electricity users in any town. The plant operator says the new equipment will run continuously, day and night."
consumption_adds = 120.0
gps_required = 570.0
applied_delay = 35.0

[node name="Hint6" parent="UI/News_Popup/Panel/Item_List/Item_Vbox" unique_id=798886875 instance=ExtResource("18_xrs0c")]
layout_mode = 2
headline = "Planning Board Approves Large Data Center"
date = "26-08-2025"
details = "The planning board has approved a permit for a large data center on the industrial estate east of town. Officials expect hundreds of construction jobs and a long-term tenant. Residents asked about power, and the utility said that servers and cooling run constantly, so the site would be a major new customer once it opens."
gps_required = 647.0
applied_delay = 60.0

[node name="Consumption10" parent="UI/News_Popup/Panel/Item_List/Item_Vbox" unique_id=1562311736 instance=ExtResource("18_xrs0c")]
layout_mode = 2
headline = "Rail Depot Switches To Electric Traction"
date = "02-10-2025"
details = "The regional rail depot has begun replacing diesel shunting engines with electric ones. Cleaner air is a welcome change for the neighbourhood, but electric engines draw heavy current when pulling freight. The depot's power contract is now one of the largest on the grid, and it runs through every shift, day and night."
consumption_adds = 160.0
gps_required = 860.0
applied_delay = 60.0

[node name="Hint7" parent="UI/News_Popup/Panel/Item_List/Item_Vbox" unique_id=1682769267 instance=ExtResource("18_xrs0c")]
layout_mode = 2
headline = "Data Center Begins Commissioning Tests"
date = "01-12-2025"
details = "Engineers at the new data center on the industrial estate have started commissioning tests. Backup generators, cooling units and server racks are being switched on in stages. A spokesperson says the site could open to customers within weeks, and the utility has asked for advance notice before each large test."
gps_required = 880.0
applied_delay = 53.0

[node name="Consumption11" parent="UI/News_Popup/Panel/Item_List/Item_Vbox" unique_id=1290722199 instance=ExtResource("18_xrs0c")]
layout_mode = 2
headline = "New Data Center Goes Live"
date = "02-01-2026"
details = "The new data center on the industrial estate went live this week, and its first customers are already moving in. Thousands of servers, and the cooling plant that keeps them from overheating, now draw power around the clock. The utility calls it the largest single connection the local grid has ever carried."
consumption_adds = 205.0
gps_required = 920.0
applied_delay = 60.0

[node name="Hint8" parent="UI/News_Popup/Panel/Item_List/Item_Vbox" unique_id=1266633152 instance=ExtResource("18_xrs0c")]
layout_mode = 2
headline = "Operator Warns Of Maintenance Risk On The Northern Line"
date = "11-02-2026"
details = "The grid operator has warned that the northern transmission line is overdue for maintenance and could be taken offline at short notice. Regional supplies are tight, and any outage there would send electricity looking for another route. Local utilities have been told to prepare emergency plans for sudden load transfers."
